{
  "name": "hubspot-airtable-sync",
  "version": "1.0.0",
  "description": "CSV → HubSpot migration and a real-time Airtable → HubSpot sync service (Wendt Partners technical assessment)",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap-hubspot.js",
    "migrate": "node src/migration/index.js",
    "migrate:dry-run": "node src/migration/index.js --dry-run",
    "start": "functions-framework --target=airtableWebhook --source=.",
    "dev": "node src/integration/server.js",
    "dev:watch": "nodemon src/integration/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/integration/server.js"
    ],
    "clearMocks": true
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "@hubspot/api-client": "^14.0.1",
    "airtable": "^0.11.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "license": "UNLICENSED",
  "private": true
}
