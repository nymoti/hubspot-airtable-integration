# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# In GCP, these are supplied to the Cloud Function as environment variables,
# with the two credentials stored in Secret Manager rather than set in plain
# text. See README.md → Deployment.
# ---------------------------------------------------------------------------

# --- HubSpot -----------------------------------------------------------------
# Private App access token from your sandbox portal:
#   Settings → Integrations → Private Apps → Create a private app
# Required scopes — verify with `npm run doctor`:
#   crm.objects.companies.read   crm.objects.companies.write
#   crm.objects.contacts.read    crm.objects.contacts.write
#   crm.objects.deals.read       crm.objects.deals.write
#   e-commerce                   (covers line items, both objects and schema —
#                                 there is no crm.schemas.line_items.write)
#
# Additionally, for `npm run bootstrap` only (the deployed function never
# creates properties, so its token can omit these):
#   crm.schemas.companies.write
#   crm.schemas.contacts.write
#   crm.schemas.deals.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Regional API host. Use api.hubapi.com unless your portal is EU-hosted.
HUBSPOT_BASE_URL=https://api.hubapi.com

# Custom properties this project creates and uses for duplicate detection.
# Change only if these names collide with properties your portal already has —
# and re-run `npm run bootstrap` afterwards.
HUBSPOT_EXTERNAL_ID_PROPERTY=external_source_id
HUBSPOT_SOURCE_SYSTEM_PROPERTY=external_source_system

# Pipeline and stage internal ids. The defaults are HubSpot's out-of-the-box
# values; a portal with a custom pipeline will use different ones.
HUBSPOT_DEFAULT_PIPELINE=default
HUBSPOT_DEFAULT_DEAL_STAGE=qualifiedtobuy
HUBSPOT_WON_DEAL_STAGE=closedwon
HUBSPOT_LOST_DEAL_STAGE=closedlost

# Client-side throttle. HubSpot allows 190 requests / 10s for private apps;
# 8/s leaves ample headroom for concurrent function instances.
HUBSPOT_MAX_RPS=8
HUBSPOT_MAX_RETRIES=5
HUBSPOT_BATCH_SIZE=100

# --- Airtable ----------------------------------------------------------------
# Personal access token: https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write — limited to the base below.
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base id, from the API docs URL for your base (starts with `app`).
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Airtable REST host, used by the Webhooks API client (the npm SDK covers only
# the records API). Override only for a proxy or a test double.
AIRTABLE_API_BASE_URL=https://api.airtable.com/v0

# Table names, only if yours differ from the defaults.
AIRTABLE_TABLE_COMPANIES=Companies
AIRTABLE_TABLE_CONTACTS=Contacts
AIRTABLE_TABLE_DEALS=Deals
AIRTABLE_TABLE_LINE_ITEMS=Line Items

# "Last modified time" field, required on all four tables. A webhook
# notification says only that *something* changed, so the rescan uses this
# field to work out which records to sync.
AIRTABLE_MODIFIED_FIELD=last_modified

# --- Airtable webhook --------------------------------------------------------
# Printed once by `npm run webhook:create`, and never retrievable afterwards.
# Airtable signs every notification with it; the service rejects notifications
# it cannot verify, so an empty value here means nothing will ever sync.
AIRTABLE_WEBHOOK_MAC_SECRET=

# How far back a notification-triggered rescan looks. Generous on purpose:
# re-syncing an unchanged record is a no-op, whereas missing one leaves HubSpot
# stale. Absorbs clock skew and delayed notifications.
RESCAN_LOOKBACK_MINUTES=10

# Safety bound on how many records a single rescan will process.
RESCAN_MAX_RECORDS=200

# --- Security ----------------------------------------------------------------
# Shared secret the Airtable automation must send as the `X-Webhook-Secret`
# header. Generate with: openssl rand -hex 32
# Optional in local development; the service refuses to start without it when
# NODE_ENV=production.
WEBHOOK_SECRET=

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# error | warn | info | debug
LOG_LEVEL=info

# File transports are for local runs only; on Cloud Functions stdout is
# captured by Cloud Logging and this is ignored.
LOG_TO_FILE=true
LOG_DIR=logs

# --- Migration (Part 1 only) -------------------------------------------------
MIGRATION_DATA_DIR=data

# true  — import records whose parent company is absent from companies.csv,
#         without the association (recommended: keeps the data, flags the gap)
# false — reject them instead
MIGRATION_IMPORT_ORPHANS=true

# Validate and report without writing anything to HubSpot.
MIGRATION_DRY_RUN=false
